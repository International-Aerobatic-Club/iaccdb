<!DOCTYPE html>
<html lang="en">
  <head xmlns:og="http://ogp.me/ns#">
    <meta charset="utf-8" />
    <%= favicon_link_tag image_path('iac-favicon.ico') %>
    <title> <%= content_for?(:title) ? yield(:title) : "IAC Contest Database" %> </title>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", 'data-turbolinks-track' => true %>
    <%= yield :headers %>
    <%= csrf_meta_tags unless @cacheable %>
    <%= render 'partials/sso_metatags' %>
  </head>
  <body>
    <%= render 'partials/menu' %>
    <div id="content">
      <div id='notice'><%= notice %></div>
      <div id='alert'><%= alert %></div>
      <%= yield %>
      <%= render 'partials/footer' %>
    </div>
  </body>
</html>
